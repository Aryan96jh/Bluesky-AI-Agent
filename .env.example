# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` — it holds secrets.

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Bot identity ---
BOT_NAME=
BOT_NICHE=AI and crypto
BOT_TONE=knowledgeable and conversational

# --- Bluesky account ---
# Create an app password at: https://bsky.app → Settings → App passwords
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=

# --- Safety / execution ---
# Both gates must be off/false for the bot to publish anything.
DRY_RUN=true
LIVE_EXECUTION_ENABLED=false

# --- Replies ---
MAX_LIVE_ACTIONS_PER_RUN=3
MAX_REPLIES_PER_DAY=10
ACTION_DELAY_SECONDS=15
MAX_CANDIDATES=12
MAX_AI_ANALYSES=8
SEARCH_LIMIT_PER_TOPIC=25

# --- Discovery ---
# Only consider posts from the last N hours…
SEARCH_HOURS=48
# …with at least this much engagement (likes + replies*3 + reposts*4).
MIN_ENGAGEMENT=5
MIN_HYPE_SCORE=0
MIN_DISCOVERY_SCORE=35

# --- AI validation thresholds (0-100) ---
AI_VALIDATION_DISCOVERY_THRESHOLD=60
AI_VALIDATION_TECHNICAL_THRESHOLD=65
AI_VALIDATION_EVIDENCE_THRESHOLD=35
AI_VALIDATION_MAX_LOW_RELEVANCE=20

# --- Spam / promotion guard ---
PROMOTION_DETECTOR_THRESHOLD=5

# --- Original posts (standalone, not replies) ---
ENABLE_ORIGINAL_POSTS=true
MAX_ORIGINAL_POSTS_PER_RUN=1
MAX_ORIGINAL_POSTS_PER_DAY=1
